[Unit]
Description=Devour Auth
After=network.target

[Service]
Type=simple
User=devour
Group=devour
EnvironmentFile=/etc/devour-authd.env
ExecStart=/opt/devour-auth/devour-authd serve
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/devour /var/backups/devour /etc/devour-authd
ProtectHome=true

[Install]
WantedBy=multi-user.target
